% ====================== TÍTULOS: JERARQUÍA APA (5 NIVELES) ======================
\usepackage{titlesec}

% Profundidad de numeración: numera hasta el nivel 4 (\paragraph = Nivel 5 de APA)
\setcounter{secnumdepth}{4}

% --- Nivel 1 (\chapter): centrado, negrita ---
% "Capítulo N: Título" en una sola línea, igual que la tesis de referencia (Migliore)
\titleformat{\chapter}[block]
    {\centering\bfseries\fontsize{14}{16}\selectfont}
    {Capítulo \thechapter:}
    {0.5em}
    {}

% --- Nivel 2 (\section): alineado a la izquierda, negrita ---
\titleformat{\section}
    {\bfseries\fontsize{12}{14}\selectfont}
    {\thesection}
    {1em}
    {}

% --- Nivel 3 (\subsection): con sangría, negrita, punto final, texto continúa en la misma línea ---
\titleformat{\subsection}[runin]
    {\normalfont\bfseries\fontsize{12}{14}\selectfont}
    {\thesubsection}
    {0.5em}
    {}
    [.]

% --- Nivel 4 (\subsubsection): con sangría, negrita cursiva, punto final, texto continúa en la misma línea ---
\titleformat{\subsubsection}[runin]
    {\normalfont\bfseries\itshape\fontsize{12}{14}\selectfont}
    {\thesubsubsection}
    {0.5em}
    {}
    [.]

% --- Nivel 5 (\paragraph): con sangría, cursiva (sin negrita), punto final, texto continúa en la misma línea ---
\titleformat{\paragraph}[runin]
    {\normalfont\itshape\fontsize{12}{14}\selectfont}
    {\theparagraph}
    {0.5em}
    {}
    [.]

% {comando}{espacio_izq}{espacio_antes}{espacio_despues}
\titlespacing*{\chapter}{0pt}{0pt}{3\baselineskip}
\titlespacing*{\section}{0pt}{1.5\baselineskip}{1\baselineskip}
\titlespacing*{\subsection}{\parindent}{1.2\baselineskip}{1em}
\titlespacing*{\subsubsection}{\parindent}{1.2\baselineskip}{1em}
\titlespacing*{\paragraph}{\parindent}{1.2\baselineskip}{1em}

